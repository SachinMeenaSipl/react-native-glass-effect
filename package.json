{
  "name": "react-native-liquid-glass-native",
  "version": "0.3.0",
  "description": "Liquid Glass (glassmorphism) for React Native, Expo and the web: real-time background blur, iOS 26 UIGlassEffect, Android AGSL refraction shader, frosted glass views, buttons and cards.",
  "author": "Sachin Meena <sachin.meena3198@gmail.com>",
  "homepage": "https://sachinmeenasipl.github.io/react-native-glass-effect/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SachinMeenaSipl/react-native-glass-effect.git"
  },
  "bugs": {
    "url": "https://github.com/SachinMeenaSipl/react-native-glass-effect/issues"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "browser": "./lib/web/index.js",
      "node": "./lib/web/index.js",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-liquid-glass.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!android/build",
    "!android/.gradle",
    "!ios/build"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.example.json --noEmit && tsc -p examples/shared",
    "test": "jest",
    "prepare": "bob build && node scripts/build-web.js",
    "clean": "del-cli lib android/build example/android/build",
    "check:android": "bash tools/android-typecheck/check.sh",
    "preview:shader": "npm --prefix tools/shader-preview install --no-audit --no-fund && node tools/shader-preview/render.js",
    "check:ios": "bash tools/ios-typecheck/check.sh"
  },
  "keywords": [
    "react-native",
    "react-native-component",
    "react-native-ui",
    "expo",
    "react-native-web",
    "nextjs",
    "liquid-glass",
    "liquidglass",
    "ios-26",
    "uiglasseffect",
    "apple-liquid-glass",
    "glassmorphism",
    "glass",
    "glass-effect",
    "glass-view",
    "frosted-glass",
    "acrylic",
    "vibrancy",
    "translucent",
    "blur",
    "blur-view",
    "background-blur",
    "backdrop-blur",
    "backdrop-filter",
    "refraction",
    "shader",
    "agsl",
    "metal",
    "android",
    "ios",
    "web",
    "fabric",
    "new-architecture",
    "turbomodule",
    "ui",
    "ui-components",
    "visual-effect",
    "material"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0",
    "react-native-web": ">=0.19.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "del-cli": "^6.0.0",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-builder-bob": "^0.40.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNLiquidGlassSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.liquidglass"
    },
    "ios": {
      "componentProvider": {
        "LiquidGlassView": "LiquidGlassViewComponentView"
      },
      "modulesProvider": {
        "LiquidGlassModule": "LiquidGlassModule"
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "peerDependenciesMeta": {
    "react-native-web": {
      "optional": true
    }
  }
}
