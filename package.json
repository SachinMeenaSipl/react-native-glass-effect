{
  "name": "@sachin-meena/react-native-liquid-glass",
  "version": "0.1.0",
  "description": "Liquid Glass surfaces for React Native: real background blur, refraction and lighting on Android, native materials on iOS.",
  "author": "Sachin Meena <sachin.meena3198@gmail.com>",
  "homepage": "https://github.com/SachinMeenaSipl/react-native-glass-effect#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SachinMeenaSipl/react-native-glass-effect.git"
  },
  "bugs": {
    "url": "https://github.com/SachinMeenaSipl/react-native-glass-effect/issues"
  },
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/index.d.ts",
  "react-native": "./src/index.ts",
  "source": "./src/index.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./lib/typescript/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "android",
    "ios",
    "react-native-liquid-glass.podspec",
    "react-native.config.js",
    "!**/__tests__",
    "!android/build",
    "!android/.gradle",
    "!ios/build"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit && tsc -p tsconfig.example.json --noEmit",
    "test": "jest",
    "prepare": "bob build",
    "clean": "del-cli lib android/build example/android/build",
    "check:android": "bash tools/android-typecheck/check.sh",
    "preview:shader": "npm --prefix tools/shader-preview install --no-audit --no-fund && node tools/shader-preview/render.js",
    "check:ios": "bash tools/ios-typecheck/check.sh"
  },
  "keywords": [
    "react-native",
    "liquid-glass",
    "glassmorphism",
    "blur",
    "android",
    "ios",
    "fabric"
  ],
  "license": "MIT",
  "peerDependencies": {
    "react": ">=18.2.0",
    "react-native": ">=0.76.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.4",
    "@types/react": "^19.1.0",
    "del-cli": "^6.0.0",
    "jest": "^29.7.0",
    "react": "19.1.0",
    "react-native": "0.81.4",
    "react-native-builder-bob": "^0.40.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.8.3"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/src"
    ],
    "testMatch": [
      "**/__tests__/**/*.test.ts"
    ]
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "RNLiquidGlassSpec",
    "type": "all",
    "jsSrcsDir": "src/specs",
    "android": {
      "javaPackageName": "com.liquidglass"
    },
    "ios": {
      "componentProvider": {
        "LiquidGlassView": "LiquidGlassViewComponentView"
      },
      "modulesProvider": {
        "LiquidGlassModule": "LiquidGlassModule"
      }
    }
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  }
}
